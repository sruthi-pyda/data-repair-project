# Copy this file to .env and fill in your values.  .env is gitignored.
# The project runs fully offline when MOCK_MODE=true — no API key required,
# and the test suite never makes a network call in either mode.

# Set to true to run the entire pipeline without an LLM API key.
MOCK_MODE=true

# ── Real-LLM repair (Phase 12) ────────────────────────────────────────────────
# The client is OpenAI-compatible, so these three variables are enough to point
# the pipeline at any compatible provider. Leave LLM_API_KEY empty (or at its
# placeholder) and every cell falls back to the mock repairer, loudly, with
# repair_method="llm->mock (not_configured)".
#
# NEVER commit a real key. This file is a template only.
LLM_API_KEY=your-key-here

# Base URL of the OpenAI-compatible endpoint.
#   omit / leave blank  → OpenAI (https://api.openai.com/v1)
#   https://api.x.ai/v1 → xAI / Grok
#   http://localhost:11434/v1 → a local OpenAI-compatible server
LLM_BASE_URL=

# Exact model id from your provider's console, e.g.
#   OpenAI : gpt-4o-mini
#   xAI    : grok-4-fast-non-reasoning
LLM_MODEL=gpt-4o-mini

# ── Optional LLM tuning (defaults shown) ──────────────────────────────────────
# Temperature 0.0 keeps repairs deterministic and reproducible. Self-consistency
# sampling (temperature > 0) is opt-in and multiplies API cost by n samples.
LLM_TEMPERATURE=0.0
# Reasoning models emit hidden reasoning tokens before the JSON; a tight cap
# truncates the answer and it is rejected as malformed. 1536 is a safe floor.
LLM_MAX_TOKENS=1536
LLM_TIMEOUT_S=30
# Extra attempts after the first, for HTTP 429/5xx only (400/401/403 never retry).
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=0.5
# On-disk cache of model responses, keyed by sha256(model + prompt), so a
# re-run of the same cells costs nothing.
LLM_CACHE_DIR=.cache/llm

# ── Reproducibility ───────────────────────────────────────────────────────────
# Random seed for reproducibility
RANDOM_SEED=42

# Root directory for datasets (relative to project root)
DATA_DIR=datasets
