# Copy this file to .env and fill in your values.
# The project runs fully offline when MOCK_MODE=true — no API key required.

# Set to true to run the entire pipeline without an LLM API key.
MOCK_MODE=true

# OpenAI API key (only needed when MOCK_MODE=false)
OPENAI_API_KEY=your-key-here

# Optional: override model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Random seed for reproducibility
RANDOM_SEED=42

# Root directory for datasets (relative to project root)
DATA_DIR=datasets
